      <parallelGateway id="joinR" name="Join R"/>
      <sequenceFlow id="flowR7" sourceRef="joinR" targetRef="endR"/>
      <endEvent id="endR"/>
    </subProcess>
    <sequenceFlow id="flowOut" sourceRef="scopeR" targetRef="end"/>
    <endEvent id="end"/>
  </process>

