<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             typeLanguage="http://www.w3.org/2001/XMLSchema"
             expressionLanguage="http://www.w3.org/1999/XPath"
             targetNamespace="http://inspector.io/demo">

  <!-- issue #359: the STANDING-dead-letter companion to demo-self-healing.bpmn20.xml — same
       `selfHealGhost` identifier (same error signature: PropertyNotFoundException's message
       is the literal expression text, so this collides on purpose), but R1/PT1S with no
       boundary timer at all, so it dead-letters fast and PERMANENTLY, exactly like the
       error-zoo fixtures. Its only job is to keep the shared class's fleet-wide total
       non-zero (`ErrorGroup#total`) so the incident ledger keeps writing an occurrence row
       every sampler cycle (`IncidentLedgerService#ingest` skips a group whose total is
       zero) — WITHOUT it, the moment a demoSelfHealing instance heals to zero residue the
       class would vanish from the ledger's per-cycle view and the occurrence series could
       never record the explicit `retryingCount = 0` sample a completed RETRYING spell needs
       to end on (RETRYING-RISK-LANE.md §3.1). One or two of these, seeded once and left
       alone for the run, is standing "this class carries other, unrelated dead-letters"
       evidence — exactly the §3.1 case the design says must NOT disqualify a self-heal
       spell ("a class routinely carries standing dead-letters; the delta is the evidence").

       Gated 6.8+ by seed.sh, paired 1:1 with demo-self-healing.bpmn20.xml. -->
  <process id="demoSelfHealingBaseline" name="Demo Self-Healing (standing baseline)" isExecutable="true">
    <startEvent id="start"/>
    <sequenceFlow id="flow1" sourceRef="start" targetRef="attempt"/>
    <serviceTask id="attempt" name="Permanent attempt"
                 flowable:async="true"
                 flowable:expression="${healed eq true or selfHealGhost.total gt 0}">
      <extensionElements>
        <flowable:failedJobRetryTimeCycle>R1/PT1S</flowable:failedJobRetryTimeCycle>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="flow2" sourceRef="attempt" targetRef="end"/>
    <endEvent id="end"/>
  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_demoSelfHealingBaseline">
    <bpmndi:BPMNPlane id="BPMNPlane_demoSelfHealingBaseline" bpmnElement="demoSelfHealingBaseline">
      <bpmndi:BPMNShape id="BPMNShape_start" bpmnElement="start">
        <omgdc:Bounds x="100" y="100" width="30" height="30"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_attempt" bpmnElement="attempt">
        <omgdc:Bounds x="180" y="85" width="100" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_end" bpmnElement="end">
        <omgdc:Bounds x="330" y="101" width="28" height="28"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_flow1" bpmnElement="flow1">
        <omgdi:waypoint x="130" y="115"/>
        <omgdi:waypoint x="180" y="115"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow2" bpmnElement="flow2">
        <omgdi:waypoint x="280" y="115"/>
        <omgdi:waypoint x="330" y="115"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
