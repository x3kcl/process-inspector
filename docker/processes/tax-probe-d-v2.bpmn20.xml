<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             typeLanguage="http://www.w3.org/2001/XMLSchema"
             expressionLanguage="http://www.w3.org/1999/XPath"
             targetNamespace="http://inspector.io/demo">

  <!-- Migration-findings taxonomy probe D, VERSION 2 (INSTANCE-MIGRATION.md §14.3/§14.9).
       The multi-instance scope `miScope` is GONE; `stepM` keeps its id at the process root.
       Structurally identical to probe A's removal — except the removed scope is an MI ROOT, so
       the pre-check deliberately KEEPS the blocker (execute refuses 422 `unmapped-activities`)
       rather than downgrading on speculation. Same key `taxProbeD`. -->
  <process id="taxProbeD" name="Taxonomy probe D — MI scope removed (v2)" isExecutable="true">
    <startEvent id="start"/>
    <sequenceFlow id="flowIn" sourceRef="start" targetRef="stepM"/>
    <userTask id="stepM" name="Step M" flowable:assignee="rest-admin"/>
    <sequenceFlow id="flowOut" sourceRef="stepM" targetRef="end"/>
    <endEvent id="end"/>
  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_taxProbeD">
    <bpmndi:BPMNPlane id="BPMNPlane_taxProbeD" bpmnElement="taxProbeD">
      <bpmndi:BPMNShape id="BPMNShape_start" bpmnElement="start">
        <omgdc:Bounds x="60" y="140" width="30" height="30"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_stepM" bpmnElement="stepM">
        <omgdc:Bounds x="150" y="125" width="100" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_end" bpmnElement="end">
        <omgdc:Bounds x="310" y="141" width="28" height="28"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_flowIn" bpmnElement="flowIn">
        <omgdi:waypoint x="90" y="155"/>
        <omgdi:waypoint x="150" y="155"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flowOut" bpmnElement="flowOut">
        <omgdi:waypoint x="250" y="155"/>
        <omgdi:waypoint x="310" y="155"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
