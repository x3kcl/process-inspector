{
  "uid": "pi-bff",
  "title": "BFF internals",
  "tags": [
    "process-inspector"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "JVM memory used",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Hikari active / max",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active / hikaricp_connections_max"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "SSE emitters",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sse_emitters_active"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "SSE errors",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(sse_emitter_errors_total[5m])"
        }
      ]
    }
  ]
}
