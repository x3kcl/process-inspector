{
  "uid": "pi-fleet",
  "title": "Fleet health",
  "tags": [
    "process-inspector"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Fan-out p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, engineId) (rate(engine_fanout_duration_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Open breakers",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "resilience4j_circuitbreaker_state{state=\"open\"}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Bulkhead available",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "resilience4j_bulkhead_available_concurrent_calls"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Engine call errors",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (engineId) (rate(engine_fanout_duration_seconds_count[5m]))"
        }
      ]
    }
  ]
}
