# ci-lib contract (https://github.com/x3kcl/process-inspector, landed through merge-queue@process-inspector).
# Parsed as data by gate.sh and mq/merge_queue.py: CI_KEY=VALUE only, never sourced.
CI_CONTRACT="bash ci/contract.sh"
CI_FORGE="github"
CI_REPO="x3kcl/process-inspector"
CI_BASE_BRANCH="main"
CI_QUEUE_LABEL="queue"
CI_MQ_REQUIRE_PR_CI="1"
CI_MQ_HOST="hp02"
CI_MQ_TOKEN_FILE="/home/flapci/.config/process-inspector/github-token"
CI_MQ_WORKDIR="/home/flapci/gitea/mq-process-inspector"
# The queue's default (1) tags every landing deploy-*; releases here are cut-release.yml's job.
CI_DEPLOY_TAG="0"
# The Maven module lives in backend/.
CI_SRC_ROOT="backend"
# RED-first landing policy (docs/landing-rules.md lr-1, lr-2; #646). The queue reads these from main.
# `dir/` is a tree prefix, anything else an fnmatch glob (`*` crosses `/`); a test path wins over a code path.
CI_MQ_RED_FIRST="1"
CI_MQ_RED_TEST_PATHS="backend/src/test/ frontend/e2e/ frontend/src/*.test.ts frontend/src/*.test.tsx scripts/*selftest.sh"
CI_MQ_RED_CODE_PATHS="backend/src/main/ frontend/src/ scripts/ ci/"
CI_MQ_RULES_URL="https://github.com/x3kcl/process-inspector/blob/main/docs/landing-rules.md"
